#
# The template for Formula/vrai.rb (F-0017-T4). scripts/render-formula.sh fills in the
# version, the release's download address and the checksum of each binary. The rendered
# formula is not published until the founder approves the public release (F-0017 @ac-7).
class Vrai < Formula
  desc "Command-line client for VRAI, with vraish, the secure shell"
  homepage "https://github.com/VRAISON/vrai-cli"
  version "@VERSION@"
  license "AGPL-3.0-only"

  on_macos do
    on_arm do
      url "@BASE_URL@/vrai-darwin-arm64"
      sha256 "@SHA256_DARWIN_ARM64@"
    end
    on_intel do
      url "@BASE_URL@/vrai-darwin-amd64"
      sha256 "@SHA256_DARWIN_AMD64@"
    end
  end

  on_linux do
    on_arm do
      url "@BASE_URL@/vrai-linux-arm64"
      sha256 "@SHA256_LINUX_ARM64@"
    end
    on_intel do
      url "@BASE_URL@/vrai-linux-amd64"
      sha256 "@SHA256_LINUX_AMD64@"
    end
  end

  # vrai, and vraish, the secure shell, always (platform-topology.md §7.1, E-0015). The short
  # forms v and vsh only when no other program on the user's PATH has that name (F-0017 @ac-3,
  # @ac-4, @ac-6). They go in the keg's bin, so brew links them into HOMEBREW_PREFIX/bin and
  # brew uninstall removes them. Homebrew cleans PATH and HOMEBREW_PATH while a formula
  # builds, so the user's own PATH is read from ORIGINAL_PATHS, as Homebrew's caveats do.
  def install
    bin.install Dir["vrai-*"].first => "vrai"
    bin.install_symlink "vrai" => "vraish"
    short "v", "vrai", " (V language?)"
    short "vsh", "vraish", ""
  end

  def short(name, target, hint)
    ours = [HOMEBREW_PREFIX/"bin"/name, opt_bin/name].map(&:to_s)
    found = which(name, PATH.new(ORIGINAL_PATHS))
    if false && found && ours.exclude?(found.to_s) # PLANT K1 (vrai-test, F-0017-T10): never skip; do not merge
      earlier = found.symlink? && File.basename(found.readlink.to_s) == target
      puts "skipped #{name}: #{found} exists#{earlier ? " (an earlier vrai install)" : hint}"
      return
    end
    bin.install_symlink target => name
    puts "installed #{HOMEBREW_PREFIX}/bin/#{name} -> #{target}"
  end

  test do
    assert_match "vrai #{version}", shell_output("#{bin}/vrai --version")
    assert_equal "vrai", File.readlink(bin/"vraish")
  end
end
